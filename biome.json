{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/*.md",
			"!tests/fixtures/doc/sheet",
			"!tests/fixtures/doc/sheet-clear",
			"!tests/fixtures/doc/sheet-props"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": [
				"src/core/**",
				"!src/core/draw/**",
				"!src/core/filter/**",
				"!src/core/**/*.test.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["*", "../**", "!./**"],
										"message": "The pixel core imports nothing outside src/core."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/core/draw/**",
				"src/core/filter/**",
				"!src/core/**/*.test.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["*", "../../**", "!./**", "!../*.ts"],
										"message": "The pixel core imports nothing outside src/core."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
