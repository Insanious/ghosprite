{
	"base": "base-clear",
	"cases": {
		"shrink": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": 2, "y": 1, "width": 10, "height": 8 } }
			}
		],
		"grow-all-sides": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": -3, "y": -2, "width": 24, "height": 18 } }
			}
		],
		"grow-left-top": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": -4, "y": -3, "width": 20, "height": 15 } }
			}
		],
		"grow-right-bottom": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": 0, "y": 0, "width": 20, "height": 16 } }
			}
		],
		"partly-outside": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": 8, "y": 6, "width": 12, "height": 10 } }
			}
		],
		"cuts-offcanvas-cel": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": 2, "y": 0, "width": 10, "height": 12 } }
			}
		],
		"cel-wholly-outside": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": 12, "y": 0, "width": 4, "height": 12 } }
			}
		],
		"trim-plain": [{ "op": "sprite.trim", "input": {} }],
		"trim-after-grow": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": -3, "y": -2, "width": 24, "height": 18 } }
			},
			{ "op": "sprite.trim", "input": {} }
		],
		"trim-after-shifted-grow": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": -5, "y": -5, "width": 30, "height": 25 } }
			},
			{ "op": "sprite.trim", "input": {} }
		],
		"trim-after-deleting-cels": [
			{
				"op": "sprite.crop",
				"input": { "rect": { "x": -3, "y": -2, "width": 24, "height": 18 } }
			},
			{ "op": "cel.delete", "input": { "layerId": "body", "frame": 1 } },
			{ "op": "cel.delete", "input": { "layerId": "body", "frame": 2 } },
			{ "op": "sprite.trim", "input": {} }
		]
	}
}
